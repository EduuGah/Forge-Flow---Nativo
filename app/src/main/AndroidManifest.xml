        <receiver
            android:name=".widget.ForgeFlowWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/forgeflow_widget_info" />
        </receiver>
    </application>

</manifest>

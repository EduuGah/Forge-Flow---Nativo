    <string name="tutorial_welcome_eyebrow">Visão geral</string>
    <string name="tutorial_welcome_title">Seu treino inteiro, em um só lugar.</string>
    <string name="tutorial_welcome_description">O ForgeFlow organiza sua rotina, acompanha cada série e transforma seu histórico em decisões claras para o próximo treino.</string>
    <string name="tutorial_dashboard_title">Dashboard diário</string>
    <string name="tutorial_dashboard_description">Veja sequência, meta semanal, treino sugerido e os resultados mais recentes.</string>
    <string name="tutorial_routines_title">Rotinas por pasta</string>
    <string name="tutorial_routines_description">Separe treinos por academia, objetivo ou fase e reorganize tudo por arraste.</string>
    <string name="tutorial_history_title">Histórico pesquisável</string>
    <string name="tutorial_history_description">Encontre sessões por nome, período e local, com todos os exercícios detalhados.</string>

    <string name="tutorial_workout_eyebrow">Durante o treino</string>
    <string name="tutorial_workout_title">Registre sem perder o ritmo.</string>
    <string name="tutorial_workout_description">Peso, repetições, aquecimento, descanso e anotações ficam acessíveis na tela mais importante do aplicativo.</string>
    <string name="tutorial_sets_title">Séries rápidas e claras</string>
    <string name="tutorial_sets_description">Marque séries concluídas, altere o tipo e consulte o desempenho anterior.</string>
    <string name="tutorial_pr_title">PRs detectados automaticamente</string>
    <string name="tutorial_pr_description">Recordes de peso e volume aparecem no momento em que você progride.</string>
    <string name="tutorial_reorder_title">Ordem flexível</string>
    <string name="tutorial_reorder_description">Segure o ícone de arraste para compactar a lista e trocar a sequência dos exercícios.</string>

    <string name="tutorial_progress_eyebrow">Depois do treino</string>

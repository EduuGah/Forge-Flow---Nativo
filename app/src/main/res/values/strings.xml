    <string name="tutorial_progress_description">O histórico alimenta gráficos, tabelas, recordes, comparações e o mapa dos lugares onde você treinou.</string>
    <string name="tutorial_filters_title">Filtros e detalhes</string>
    <string name="tutorial_filters_description">Abra qualquer treino ou exercício e confira a série exata que gerou cada recorde.</string>

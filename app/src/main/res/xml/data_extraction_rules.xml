<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore/forgeflow_settings.preferences_pb" />
        <include
            domain="file"
            path="progress_photos/" />
        <include
            domain="file"
            path="profile/" />
        <include
            domain="file"
            path="nutrition_photos/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore/forgeflow_settings.preferences_pb" />
        <include
            domain="file"
            path="progress_photos/" />
        <include
            domain="file"
            path="profile/" />
        <include
            domain="file"
            path="nutrition_photos/" />
    </device-transfer>
</data-extraction-rules>
